{
  "cleanUrls": true,
  "redirects": [
    { "source": "/my-thoughts", "destination": "/the-writers-room", "permanent": false },
    { "source": "/my-thoughts.html", "destination": "/the-writers-room", "permanent": false },
    { "source": "/the-chapter-room", "destination": "/chapter-room", "permanent": false },
    { "source": "/the-chapter-room.html", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/explore", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/book-of-the-month", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/my-reading", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/community", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/profile", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/genre", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/book", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/chapter", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/notifications", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/search", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/finish", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter-room/thread", "destination": "/chapter-room", "permanent": false },
    { "source": "/explore", "destination": "/chapter-room", "permanent": false },
    { "source": "/book-of-the-month", "destination": "/chapter-room", "permanent": false },
    { "source": "/my-reading", "destination": "/chapter-room", "permanent": false },
    { "source": "/community", "destination": "/chapter-room", "permanent": false },
    { "source": "/genre", "destination": "/chapter-room", "permanent": false },
    { "source": "/book", "destination": "/chapter-room", "permanent": false },
    { "source": "/chapter", "destination": "/chapter-room", "permanent": false },
    { "source": "/finish", "destination": "/chapter-room", "permanent": false },
    { "source": "/thread", "destination": "/chapter-room", "permanent": false }
  ],
  "rewrites": [
    { "source": "/chapter-room", "destination": "/chapter-room/index.html" },
    { "source": "/chapter-room/", "destination": "/chapter-room/index.html" },
    { "source": "/the-chapter-room", "destination": "/the-chapter-room.html" },
    { "source": "/the-chapter-room.html", "destination": "/the-chapter-room.html" },
    {
      "source": "/story/:authorSlug/:slug",
      "destination": "https://the-nebula-house-backend.onrender.com/api/posts/share/:slug"
    },
    {
      "source": "/story/:slug",
      "destination": "https://the-nebula-house-backend.onrender.com/api/posts/share/:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://apis.google.com https://cdn.quilljs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.quilljs.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://the-nebula-house-backend.onrender.com https://accounts.google.com; frame-src https://accounts.google.com;"
        }
      ]
    }
  ]
}
